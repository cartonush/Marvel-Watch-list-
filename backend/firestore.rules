rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function usernameAccount() {
      return signedIn() && request.auth.token.email is string
        && request.auth.token.email.matches('^[a-z][a-z0-9_]{2,23}@users[.]marvel-list[.]invalid$');
    }
    function owner() {
      return usernameAccount()
        && request.auth.uid == get(/databases/$(database)/documents/system/owner).data.uid;
    }
    function approved() {
      return usernameAccount() && (owner()
        || (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'approved'
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.view == true));
    }
    function manage() {
      return approved() && (owner()
        || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.manage == true
        || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.Fmanage == true);
    }
    function fullManage() {
      return approved() && (owner()
        || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.Fmanage == true);
    }
    function userShape(d) {
      return d.keys().hasAll(['username','email','view','manage','Fmanage','status','createdAt','updatedAt'])
        && d.keys().hasOnly(['username','email','view','manage','Fmanage','status','createdAt','updatedAt'])
        && d.username is string && d.username.matches('^[a-z][a-z0-9_]{2,23}$')
        && d.email is string && d.email.size() <= 254
        && d.email == d.username + '@users.marvel-list.invalid'
        && d.view is bool && d.manage is bool && d.Fmanage is bool
        && d.status in ['pending','approved','disabled']
        && d.createdAt is timestamp && d.updatedAt == request.time
        && (d.status == 'approved' || (!d.view && !d.manage && !d.Fmanage));
    }
    match /system/{key} {
      // Owner bootstrap uses the Admin SDK. No browser can assign or replace the owner.
      allow read: if owner();
      allow write: if false;
    }
    match /users/{uid} {
      allow get: if (signedIn() && request.auth.uid == uid) || fullManage();
      allow list: if fullManage();
      allow create: if usernameAccount() && request.auth.uid == uid
        && userShape(request.resource.data)
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time;
      allow update: if userShape(request.resource.data)
        && uid != get(/databases/$(database)/documents/system/owner).data.uid
        && request.resource.data.username == resource.data.username
        && request.resource.data.email == resource.data.email
        && request.resource.data.createdAt == resource.data.createdAt
        && (owner() || (fullManage() && uid != request.auth.uid
          && !resource.data.manage && !resource.data.Fmanage
          && !request.resource.data.manage && !request.resource.data.Fmanage
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','view','updatedAt'])));
      // Disable accounts instead of removing their audit identity.
      allow delete: if false;
    }
    match /handles/{name} {
      allow get: if approved();
      allow list: if false;
      allow create: if approved() && name == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.username
        && request.resource.data.keys().hasOnly(['uid','username','createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.username == name && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }
    function activeUser(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data.status == 'approved'
        && get(/databases/$(database)/documents/users/$(uid)).data.view == true;
    }
    function validPair(id,d) {
      return d.keys().hasOnly(['a','b','aName','bName','requestedBy','status','createdAt','updatedAt'])
        && d.a is string && d.b is string && d.a != d.b
        && (id == d.a + '_' + d.b || id == d.b + '_' + d.a)
        && d.requestedBy in [d.a,d.b]
        && d.aName == get(/databases/$(database)/documents/users/$(d.a)).data.username
        && d.bName == get(/databases/$(database)/documents/users/$(d.b)).data.username;
    }
    match /friendships/{id} {
      allow get, list: if approved() && (resource.data.a == request.auth.uid || resource.data.b == request.auth.uid);
      allow create: if approved() && validPair(id,request.resource.data)
        && request.resource.data.requestedBy == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time && request.resource.data.updatedAt == request.time
        && activeUser(request.resource.data.a) && activeUser(request.resource.data.b);
      allow update: if approved() && validPair(id,request.resource.data)
        && resource.data.status == 'pending' && request.resource.data.status == 'accepted'
        && resource.data.requestedBy != request.auth.uid
        && request.auth.uid in [resource.data.a,resource.data.b]
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updatedAt'])
        && request.resource.data.updatedAt == request.time;
      allow delete: if approved() && request.auth.uid in [resource.data.a,resource.data.b];
    }
    function acceptedPair(other) {
      return (exists(/databases/$(database)/documents/friendships/$(request.auth.uid + '_' + other))
        && get(/databases/$(database)/documents/friendships/$(request.auth.uid + '_' + other)).data.status == 'accepted')
        || (exists(/databases/$(database)/documents/friendships/$(other + '_' + request.auth.uid))
        && get(/databases/$(database)/documents/friendships/$(other + '_' + request.auth.uid)).data.status == 'accepted');
    }
    match /friendProgress/{uid} {
      allow get: if approved() && (request.auth.uid == uid || acceptedPair(uid));
      allow list: if false;
      allow create, update: if approved() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['username','watched','updatedAt'])
        && request.resource.data.username == get(/databases/$(database)/documents/users/$(uid)).data.username
        && request.resource.data.watched is map && request.resource.data.watched.size() <= 1000
        && request.resource.data.updatedAt == request.time;
      allow delete: if approved() && request.auth.uid == uid;
    }
    function watchShape(d) {
      return d.keys().hasOnly(['v','progress','favorites','skipped','lists','settings','activeList','name','updatedAt'])
        && d.keys().hasAll(['v','updatedAt']) && d.v == 1 && d.updatedAt == request.time
        && (!d.keys().hasAny(['progress']) || (d.progress is map && d.progress.size() <= 600))
        && (!d.keys().hasAny(['favorites']) || (d.favorites is map && d.favorites.size() <= 600))
        && (!d.keys().hasAny(['skipped']) || (d.skipped is map && d.skipped.size() <= 600))
        && (!d.keys().hasAny(['lists']) || (d.lists is map && d.lists.size() <= 5))
        && (!d.keys().hasAny(['settings']) || (d.settings is map && d.settings.size() <= 12))
        && (!d.keys().hasAny(['activeList']) || d.activeList == null
          || (d.activeList is int && d.activeList >= 0 && d.activeList < 5))
        && (!d.keys().hasAny(['name']) || (d.name is string && d.name.size() <= 32));
    }
    match /userWatch/{uid} {
      allow get: if approved() && (request.auth.uid == uid || acceptedPair(uid));
      allow list, delete: if false;
      allow create, update: if approved() && request.auth.uid == uid
        && watchShape(request.resource.data);
    }
    match /pushSubscriptions/{uid}/devices/{deviceId} {
      // Each approved account can subscribe only its own devices.
      allow get, list: if approved() && request.auth.uid == uid;
      allow create, update: if approved() && request.auth.uid == uid
        && deviceId.matches('[a-f0-9-]{36}')
        && request.resource.data.keys().hasOnly(['subscription','updatedAt'])
        && request.resource.data.updatedAt == request.time
        && request.resource.data.subscription is map
        && request.resource.data.subscription.keys().hasAll(['endpoint','keys'])
        && request.resource.data.subscription.keys().hasOnly(['endpoint','expirationTime','keys'])
        && request.resource.data.subscription.endpoint is string
        && request.resource.data.subscription.endpoint.size() < 1000
        && request.resource.data.subscription.endpoint.matches('https://.*')
        && request.resource.data.subscription.keys is map
        && request.resource.data.subscription.keys.keys().hasAll(['p256dh','auth'])
        && request.resource.data.subscription.keys.p256dh is string
        && request.resource.data.subscription.keys.auth is string;
      allow delete: if approved() && request.auth.uid == uid;
    }
    match /pushDelivered/{id} { allow read, write: if false; }
    match /notificationEvents/{id} { allow read, write: if false; }
    match /notificationStates/{id} { allow read, write: if false; }
    match /notifications/{uid}/items/{id} {
      allow get, list: if approved() && request.auth.uid == uid;
      allow update: if approved() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readAt'])
        && request.resource.data.readAt == request.time;
      allow create, delete: if false;
    }
    match /notificationSettings/{uid} {
      allow get: if approved() && request.auth.uid == uid;
      allow list: if false;
      allow create, update: if approved() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['types','updatedAt'])
        && request.resource.data.types is map
        && request.resource.data.types.keys().hasOnly(['registration','titleRequest','release','message','search','role','deletion','titleAdded','friend'])
        && request.resource.data.types.values().hasOnly([true,false])
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }
    match /messages/{id} {
      allow get: if approved() && request.auth.uid in [resource.data.from,resource.data.to];
      allow list: if approved() && resource.data.from == request.auth.uid;
      allow list: if approved() && resource.data.to == request.auth.uid;
      allow create: if approved()
        && request.resource.data.keys().hasAll(['from','to','text','createdAt'])
        && request.resource.data.keys().hasOnly(['from','to','text','createdAt'])
        && request.resource.data.from == request.auth.uid
        && request.resource.data.to is string && request.resource.data.to != request.auth.uid
        && activeUser(request.resource.data.to)
        && acceptedPair(request.resource.data.to)
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 1000
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }
    match /titleRequests/{id} {
      allow get: if approved() && (resource.data.requestedBy == request.auth.uid || manage());
      allow list: if manage();
      allow create: if approved()
        && request.resource.data.keys().hasAll(['title','imdb','reason','requestedBy','status','createdAt','updatedAt'])
        && request.resource.data.keys().hasOnly(['title','imdb','reason','requestedBy','status','createdAt','updatedAt'])
        && request.resource.data.title is string && request.resource.data.title.size() >= 2 && request.resource.data.title.size() <= 250
        && request.resource.data.imdb is string && request.resource.data.imdb.matches('https://www[.]imdb[.]com/title/tt[0-9]{7,10}/')
        && request.resource.data.reason is string && request.resource.data.reason.size() <= 1000
        && request.resource.data.requestedBy == request.auth.uid && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time && request.resource.data.updatedAt == request.time;
      allow update: if manage() && resource.data.status == 'pending'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updatedAt','updatedBy'])
        && request.resource.data.status in ['approved','rejected']
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }
    function titleShape(d) {
      return d.keys().hasAll(['title','date','seconds','kind','episodes','createdBy','createdAt','archived','group','collections','url','poster','priority','reason'])
        && d.keys().hasOnly(['title','date','seconds','kind','episodes','createdBy','createdAt','archived','group','collections','url','poster','priority','reason','imdb'])
        && d.title is string && d.title.size() > 0 && d.title.size() <= 250
        && d.date is string && d.date.size() <= 20
        && (d.seconds == null || (d.seconds is int && d.seconds > 0 && d.seconds <= 100000000))
        && d.kind in ['movie','series'] && d.episodes is int && d.episodes > 0 && d.episodes <= 1000
        && d.createdBy is string && d.createdAt is timestamp && d.archived is bool
        && d.group in ['1','2','3','4','5','6','7','extra']
        && d.collections is list && d.collections.size() >= 1 && d.collections.size() <= 2
        && d.collections[0] == 'marvel'
        && (d.collections.size() == 1 || d.collections[1] == 'mcu')
        && d.url is string && d.url.size() <= 1000 && d.url.matches('https://.*')
        && d.poster is string && d.poster.size() <= 500
        && (d.poster == '' || d.poster.matches('assets/[A-Za-z0-9_-]+[.]webp')
          || d.poster.matches('imdb:tt[0-9]{7,10}')
          || d.poster.matches('https://m[.]media-amazon[.]com/images/[^ ]+'))
        && (!d.keys().hasAny(['imdb'])
          || (d.imdb is string && d.imdb.matches('https://www[.]imdb[.]com/title/tt[0-9]{7,10}/')))
        && d.priority in ['core','background','optional','later']
        && d.reason is string && d.reason.size() <= 1000;
    }
    match /titles/{id} {
      allow read: if approved();
      allow create: if manage() && titleShape(request.resource.data)
        && request.resource.data.keys().hasAny(['imdb'])
        && request.resource.data.poster != ''
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time && !request.resource.data.archived;
      // Ordinary managers can add but cannot edit or remove existing titles.
      allow update: if titleShape(request.resource.data)
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt
        && (owner() || (fullManage() && request.resource.data.archived == resource.data.archived));
      // Archiving is owner-only and reversible. Hard deletion is never a browser operation.
      allow delete: if false;
    }
    match /deletionRequests/{id} {
      allow read: if fullManage();
      allow create: if fullManage()
        && request.resource.data.keys().hasOnly(['titleId','reason','requestedBy','createdAt','updatedAt','status'])
        && request.resource.data.titleId is string
        && exists(/databases/$(database)/documents/titles/$(request.resource.data.titleId))
        && request.resource.data.reason is string && request.resource.data.reason.size() > 0
        && request.resource.data.reason.size() <= 1000
        && request.resource.data.requestedBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time && request.resource.data.status == 'pending';
      allow update: if owner()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updatedAt'])
        && resource.data.status == 'pending'
        && request.resource.data.updatedAt == request.time
        && request.resource.data.status in ['approved','rejected']
        && (request.resource.data.status == 'rejected'
          || getAfter(/databases/$(database)/documents/titles/$(resource.data.titleId)).data.archived == true);
      allow delete: if false;
    }
    match /settings/basic {
      allow read: if approved();
      allow create, update: if manage()
        && request.resource.data.keys().hasOnly(['announcement','defaultTheme','updatedAt','updatedBy'])
        && request.resource.data.announcement is string && request.resource.data.announcement.size() <= 1000
        && request.resource.data.defaultTheme in ['dark','light','system']
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy == request.auth.uid;
      allow delete: if false;
    }
    match /settings/admin {
      allow read, write: if owner();
    }
    function engineShape(d) {
      return d.keys().hasAll(['name','sites','createdBy','createdAt','updatedBy','updatedAt'])
        && d.keys().hasOnly(['name','sites','createdBy','createdAt','updatedBy','updatedAt'])
        && d.name is string && d.name.size() >= 2 && d.name.size() <= 40
        && d.sites is list && d.sites.size() >= 1 && d.sites.size() <= 10
        && d.createdBy is string && d.createdAt is timestamp
        && d.updatedBy is string && d.updatedAt == request.time;
    }
    match /searchEngines/{id} {
      allow read: if approved();
      allow create: if manage() && engineShape(request.resource.data)
        && (id in ['direct','torrents','subs'] || id.matches('custom-[a-f0-9-]{36}'))
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.createdAt == request.time;
      allow update: if manage() && engineShape(request.resource.data)
        && request.resource.data.name == resource.data.name
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.sites.hasAll(resource.data.sites)
        && request.resource.data.updatedBy == request.auth.uid;
      allow delete: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
